---
import { trustedBySection } from "../home/trustedby/trustedby";
---

<section class="bg-black pt-16 pb-10" id="why-attend">
  <div class="container">
    <div class="mb-12 text-center">
      <h2 class="acc-reveal mb-3 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
        Event for the Open AI Era.
      </h2>
      <p class="acc-reveal mx-auto mt-4 max-w-lg text-base leading-relaxed text-para" data-delay="1">
        1,000 builders. $100 in free compute. Hardware drops live on stage.
        One day to ship something real.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

      <div class="acc-reveal" data-delay="1">
        <div class="relative z-0 h-[480px] rounded-xl cursor-default transition-transform duration-500 ease-out hover:z-10 hover:scale-[1.06]">
          <div class="absolute inset-0 overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[#111]"><img src="/images/accelerate-26/card-compute-match.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" /></div>
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, transparent 55%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="mb-1.5 text-lg font-semibold text-white">100% Ticket-to-Compute Match</h3>
              <p class="text-base leading-relaxed text-white/65">Your $99 pass includes $100 in Akash compute credits. Ship real workloads before you leave.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="acc-reveal" data-delay="2">
        <div class="relative z-0 h-[480px] rounded-xl cursor-default transition-transform duration-500 ease-out hover:z-10 hover:scale-[1.06]">
          <div class="absolute inset-0 overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[#111]"><img src="/images/accelerate-26/card-hacking-rooms.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" /></div>
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, transparent 55%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="mb-1.5 text-lg font-semibold text-white">Hacking & Breakout Rooms</h3>
              <p class="text-base leading-relaxed text-white/65">Live workshop zones with Akash engineers on standby. Bring your laptop and optimize your stack in real time.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="acc-reveal" data-delay="3">
        <div class="relative z-0 h-[480px] rounded-xl cursor-default transition-transform duration-500 ease-out hover:z-10 hover:scale-[1.06]">
          <div class="absolute inset-0 overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[#111]"><img src="/images/accelerate-26/card-hardware-merch.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" /></div>
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, transparent 55%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="mb-1.5 text-lg font-semibold text-white">Next-Gen Hardware & Merch</h3>
              <p class="text-base leading-relaxed text-white/65">Mac Minis, RTX 5090s, and premium Akash merch on the line. Live drops throughout the day.</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="acc-reveal mt-[140px] flex flex-wrap items-center justify-center gap-x-10 gap-y-5" data-delay="5">
      {
        trustedBySection
          .filter((item) =>
            ["Nous", "YesandNo", "Texas", "Venice", "Morpheus", "Bagel", "flock"].includes(item.title)
          )
          .map((item) => (
            <img
              src={item.image}
              alt={item.title}
              style={`height:${{ "Pluralis Research": 18, "flock": 16 }[item.title] ?? item.height ?? 24}px`}
              class="w-auto object-contain opacity-25 dark:invert"
              loading="lazy"
            />
          ))
      }
    </div>
  </div>
</section>
