---
---

<section class="bg-black py-20" id="who-its-for">
  <div class="container">
    <div class="mb-12 text-center">
      <h2 class="acc-reveal mb-3 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
        Engineered for High-Performance Operators.
      </h2>
      <p class="acc-reveal mx-auto mt-4 max-w-2xl text-base leading-relaxed text-para" data-delay="1">
        Whether you're deploying massive clusters or backing the infrastructure
        scaling them, Accelerate is optimized for your workflow.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">

      <!-- Row 1: wide (2 cols) + narrow (1 col) -->
      <div class="acc-reveal col-span-1 md:col-span-2" data-delay="1">
        <div class="relative z-0 h-[480px] rounded-xl cursor-default transition-transform duration-500 ease-out hover:z-10 hover:scale-[1.025]">
          <div class="absolute inset-0 overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[#111]"><img src="/images/accelerate-26/card-infra-engineers.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" /></div>
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, transparent 55%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="mb-3 inline-flex items-center rounded-full border border-white/20 px-3 py-1 text-xs font-medium text-white/55">
                Infra Engineers
              </span>
              <p class="text-xl font-light leading-snug text-white">
                Deploy container-native applications at scale with production-grade Kubernetes orchestration, open APIs, and zero provider lock-in.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="acc-reveal col-span-1" data-delay="2">
        <div class="relative z-0 h-[480px] rounded-xl cursor-default transition-transform duration-500 ease-out hover:z-10 hover:scale-[1.025]">
          <div class="absolute inset-0 overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[#111]"><img src="/images/accelerate-26/card-ai-researchers.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" /></div>
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, transparent 55%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="mb-3 inline-flex items-center rounded-full border border-white/20 px-3 py-1 text-xs font-medium text-white/55">
                AI & ML Researchers
              </span>
              <p class="text-xl font-light leading-snug text-white">
                Access H100s and A100s on-demand — no waitlists, no artificial premiums.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: narrow (1 col) + wide (2 cols) -->
      <div class="acc-reveal col-span-1" data-delay="1">
        <div class="relative z-0 h-[480px] rounded-xl cursor-default transition-transform duration-500 ease-out hover:z-10 hover:scale-[1.025]">
          <div class="absolute inset-0 overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[#111]"><img src="/images/accelerate-26/card-compute-founders.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" /></div>
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, transparent 55%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="mb-3 inline-flex items-center rounded-full border border-white/20 px-3 py-1 text-xs font-medium text-white/55">
                Compute Founders
              </span>
              <p class="text-xl font-light leading-snug text-white">
                Cut operational burn and meet the architects behind the next cloud stack.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="acc-reveal col-span-1 md:col-span-2" data-delay="2">
        <div class="relative z-0 h-[480px] rounded-xl cursor-default transition-transform duration-500 ease-out hover:z-10 hover:scale-[1.025]">
          <div class="absolute inset-0 overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[#111]"><img src="/images/accelerate-26/card-infra-investors.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" /></div>
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, transparent 55%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="mb-3 inline-flex items-center rounded-full border border-white/20 px-3 py-1 text-xs font-medium text-white/55">
                Infra Investors
              </span>
              <p class="text-xl font-light leading-snug text-white">
                Deep-tech deal flow. Meet the teams building production-grade alternatives to legacy cloud monopolies with curated ecosystem networking.
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
