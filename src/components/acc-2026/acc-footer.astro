---
import FooterYear from "../footer/footer-year";
---

<footer class="border-t border-border/30 bg-black py-8">
  <div class="container flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-3 text-xs">
      <span class="font-semibold text-foreground/50">Akash Accelerate SF 2026</span>
      <span class="text-foreground/20">·</span>
      <span class="text-foreground/30">Oct 5 · The Conservatory at One Sansome</span>
    </div>
    <div class="flex items-center gap-5 text-xs">
      {
        [
          { label: "Twitter", href: "https://x.com/akashnet_" },
          { label: "Discord", href: "https://discord.com/invite/akash" },
          { label: "GitHub", href: "https://github.com/akash-network" },
        ].map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground/30 transition-colors hover:text-foreground/60"
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <p class="w-full text-center text-xs text-foreground/20 md:w-auto">
      © Akash Network <FooterYear client:load />
    </p>
  </div>
</footer>
