---
import { acc2026 } from "./acc-2026";
---

<section
  class="relative flex items-start overflow-hidden bg-black pb-10 pt-16 md:pt-20"
>

  <div class="container relative z-10 flex flex-col items-center text-center">
    <div class="acc-reveal mb-6 inline-flex items-center rounded-full border border-white/20 px-4 py-1.5 text-xs font-medium text-white/55 backdrop-blur-sm">
      Oct 5, 2026 &nbsp;·&nbsp; San Francisco &nbsp;·&nbsp; The Conservatory
    </div>
    <h1
      class="acc-reveal mb-5 max-w-3xl text-6xl font-extrabold !leading-[1.02] tracking-[-0.04em] text-foreground md:text-7xl xl:text-8xl"
    >
      <span class="block" style="line-height:1.02">Accelerate</span>
      <span
        id="acc-animated-word"
        class="acc-word block text-foreground/70"
        style="line-height:1.02;min-height:1.02em;"
        aria-live="polite"
      ></span>
    </h1>

    <p class="acc-reveal mb-9 max-w-lg text-base leading-relaxed text-para md:text-lg" data-delay="1">
      One high-signal day in SF dedicated to high-performance compute,
      open-source AI, and the raw silicon infrastructure scaling the next
      generation of human intellect.
    </p>

    <div class="acc-reveal mb-8 flex flex-wrap justify-center gap-3" data-delay="2">
      <a
        href={acc2026.register}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-foreground px-6 py-3 text-sm font-medium text-background transition-colors hover:bg-foreground/90"
      >
        Get Early Bird Pass ($99)
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>
      <a
        href={acc2026.calendarLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-transparent px-6 py-3 text-sm font-medium text-foreground/70 transition-colors hover:border-white/30 hover:text-foreground"
      >
        Join Virtually — Add to Calendar
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .acc-word::after {
    content: "|";
    opacity: 1;
    animation: acc-blink 1s step-end infinite;
    color: inherit;
  }
  @keyframes acc-blink {
    50% { opacity: 0; }
  }
</style>

<script>
  (function () {
    const words = [
      "Openness",
      "Abundance",
      "Sovereignty",
      "Adaptability",
      "Machine Age",
      "Craftmanship",
      "Distribution",
      "Energy",
      "San Francisco",
      "Progress",
      "Mindfulness",
    ];
    const el = document.getElementById("acc-animated-word") as HTMLElement | null;
    if (!el) return;
    const typedEl = el as HTMLElement;

    let wi = 0, ci = 0, del = false;

    function step() {
      const w = words[wi];
      if (!del) {
        if (ci < w.length) {
          ci++;
          typedEl.textContent = w.slice(0, ci);
          setTimeout(step, 90);
        } else {
          setTimeout(() => { del = true; step(); }, 2200);
        }
      } else {
        if (ci > 0) {
          ci--;
          typedEl.textContent = w.slice(0, ci);
          setTimeout(step, 45);
        } else {
          wi = (wi + 1) % words.length;
          del = false;
          setTimeout(step, 250);
        }
      }
    }

    setTimeout(step, 600);
  })();
</script>
