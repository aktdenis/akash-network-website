---
import { acc2026 } from "./acc-2026";
---

<section class="bg-black py-20">
  <div class="container">
    <div class="acc-reveal grid grid-cols-1 items-center gap-10 md:grid-cols-2" data-delay="1">

      <!-- Photo -->
      <div class="relative aspect-square w-full overflow-hidden rounded-2xl bg-[#111]">
        <img src="/images/accelerate-26/big-tech-podcast.webp" alt="Big Technology Podcast" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
      </div>

      <!-- Text -->
      <div class="flex flex-col justify-center">
        <span class="mb-5 inline-flex w-fit items-center rounded-full border border-white/20 px-3.5 py-1.5 text-xs font-medium text-white/50">
          Featured Guest
        </span>
        <h2 class="mb-5 text-3xl font-semibold !leading-[1.12] tracking-tight text-foreground md:text-4xl xl:text-5xl">
          Big Technology takes the stage.
        </h2>
        <p class="max-w-md text-base leading-relaxed text-para">
          Alex Kantrowitz — journalist, author, and host of the Big Technology Podcast — joins Accelerate for a live recording. Expect an unfiltered conversation on AI power concentration, open infrastructure as a counterforce, and what the next chapter of the internet actually looks like.
        </p>
        <a
          href={acc2026.register}
          class="mt-8 inline-flex w-fit items-center gap-2 rounded-lg bg-foreground px-6 py-3 text-sm font-medium text-background transition-colors hover:bg-foreground/90"
        >
          Secure Your Seat
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>
