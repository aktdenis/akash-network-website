---
import { acc2026 } from "./acc-2026";
---

<section class="bg-black py-12">
  <div class="container">
    <div class="relative overflow-hidden rounded-2xl" style="aspect-ratio: 16/9;">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${acc2026.youtube}?autoplay=1&mute=1&loop=1&playlist=${acc2026.youtube}&controls=0&showinfo=0&rel=0&modestbranding=1&cc_load_policy=0&iv_load_policy=3`}
        title="Akash Accelerate Highlights"
        allow="autoplay; encrypted-media"
        allowfullscreen
        style="position:absolute;top:-5%;left:-1%;width:102%;height:110%;border:0;"
      ></iframe>
    </div>
  </div>
</section>
