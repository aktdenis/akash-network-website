<style is:global>
  .acc-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.65s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.65s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .acc-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .acc-reveal[data-delay="1"] { transition-delay: 80ms; }
  .acc-reveal[data-delay="2"] { transition-delay: 160ms; }
  .acc-reveal[data-delay="3"] { transition-delay: 240ms; }
  .acc-reveal[data-delay="4"] { transition-delay: 320ms; }
  .acc-reveal[data-delay="5"] { transition-delay: 400ms; }
  .acc-reveal[data-delay="6"] { transition-delay: 480ms; }
  .acc-reveal[data-delay="7"] { transition-delay: 560ms; }
  .acc-reveal[data-delay="8"] { transition-delay: 640ms; }
</style>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('is-visible');
          obs.unobserve(e.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -30px 0px' },
  );
  document.querySelectorAll('.acc-reveal').forEach((el) => obs.observe(el));
</script>
